# ─── X green Energy: variables de entorno ─────────────────────────────────
# Copia este archivo como .env.local (npm run setup lo hace por ti y genera las claves).
# En Vercel, cada variable va en Settings → Environment Variables con el mismo nombre.
# La lista de configuración del admin (Admin → Pagos) muestra en vivo cuáles faltan.

# ─── Modo ──────────────────────────────────────────────────────────────────
# true (o vacío) = modo de pruebas: cuenta de pruebas, pago de prueba y pagos de prueba de Mercado Pago o de testnet.
# false = cobros reales: solo Google para entrar; solo activan planes Mercado Pago real, cripto en la red principal
# y los pagos por transferencia que registra el administrador.
DEMO_MODE=true

# ─── Acceso ────────────────────────────────────────────────────────────────
# Clave para firmar las sesiones. npm run setup genera una aleatoria.
# En Vercel o con DEMO_MODE=false la app no arranca sin ella.
BETTER_AUTH_SECRET=

# URL pública de la app (para Google y las cookies). En Vercel: https://tu-dominio
BETTER_AUTH_URL=http://localhost:3000

# PIN para entrar como administrador. npm run setup genera uno aleatorio y lo muestra una vez.
# En Vercel o con DEMO_MODE=false, sin ADMIN_PIN nadie puede entrar al admin.
ADMIN_PIN=

# Con DEMO_MODE=false, solo estos correos (además del PIN) pueden ser administradores.
# Separados por comas: socio@inworldenergy.co,operaciones@inworldenergy.co
# En modo de pruebas, la cuenta de pruebas también puede administrar con el PIN.
ADMIN_EMAILS=

# ─── Ingreso con Google ────────────────────────────────────────────────────
# Obligatorio con DEMO_MODE=false. Paso a paso en el README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Mercado Pago: tarjeta, PSE y Nequi (Nequi y Daviplata se pagan por PSE) ─
# Access Token de Tus integraciones → tu aplicación: el de Credenciales de prueba (para probar) o el de Producción
# (para cobrar). Los dos pueden empezar por APP_USR-: la app le pregunta a Mercado Pago si la cuenta es de prueba.
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta de las notificaciones (Tus integraciones → Webhooks). Verifica que el aviso venga de Mercado Pago.
# URL que debes configurar en Mercado Pago, evento "Pagos": https://tu-dominio/api/webhooks/mercadopago
MERCADOPAGO_WEBHOOK_SECRET=

# ─── Cripto directo: USDT y BNB en BNB Chain ───────────────────────────────
# Dirección PÚBLICA (0x…) de la billetera de la empresa. Nunca la frase semilla.
CRYPTO_TREASURY_ADDRESS=
# bsc (BNB Smart Chain) o bsc-testnet (pruebas sin dinero real)
CRYPTO_NETWORK=bsc
# Confirmaciones antes de activar el mes (por defecto 5)
CRYPTO_CONFIRMATIONS=5
# Opcional: nodo propio (por defecto el nodo público de BNB Chain)
BSC_RPC_URL=
# Opcional: contrato del USDT (por defecto el oficial de BNB Chain)
USDT_CONTRACT=
# Opcional: llave gratuita de CoinGecko (plan Demo) para más límite de consultas
COINGECKO_API_KEY=

# ─── Trust Wallet en el celular por QR (opcional) ──────────────────────────
# Project ID gratuito de https://dashboard.reown.com (antes WalletConnect Cloud).
NEXT_PUBLIC_REOWN_PROJECT_ID=

# ─── Base de datos ─────────────────────────────────────────────────────────
# Vacío = archivo local data/iwe.db (no hay que instalar nada).
# En Vercel usa Turso (Vercel → Storage → Turso): crea estas dos variables solo.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── Vistas previas de Vercel ──────────────────────────────────────────────
# Las vistas previas suelen usar la misma base de datos que producción. Por eso una vista previa con
# migraciones pendientes se detiene en lugar de aplicarlas. Ponlo en true solo si el entorno Preview
# tiene su propia base (su propio TURSO_DATABASE_URL).
ALLOW_PREVIEW_MIGRATIONS=

# ─── Soporte ──────────────────────────────────────────────────────────────
# Opcional: también se puede guardar el contacto real desde Admin → Planta.
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=

# ─── Verificación de pagos en segundo plano ────────────────────────────────
# Clave aleatoria de al menos 32 caracteres, configurada en Vercel Production.
# El trabajo diario de vercel.json llama /api/cron/payments con Bearer CRON_SECRET.
# Para frecuencia de minutos, ajusta el cron con un plan que lo permita o usa un programador externo autenticado.
CRON_SECRET=
