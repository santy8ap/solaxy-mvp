# ─── Solaxy: variables de entorno ───────────────────────────────────────────
# Copia este archivo como .env.local (npm run setup lo hace por ti).

# Clave para firmar las sesiones. npm run setup genera una aleatoria.
BETTER_AUTH_SECRET=

# URL donde corre la app (cámbiala si la publicas en otro dominio).
BETTER_AUTH_URL=http://localhost:3000

# ─── Ingreso con Google (opcional) ──────────────────────────────────────────
# Sin esto, el botón de Google avisa y se usa la cuenta demo. Paso a paso en el README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Trust Wallet en el celular por QR (opcional) ──────────────────────────
# Project ID gratuito de https://dashboard.reown.com (antes WalletConnect Cloud).
NEXT_PUBLIC_REOWN_PROJECT_ID=

# ─── Base de datos ─────────────────────────────────────────────────────────
# Vacío = archivo local data/solaxy.db (no hay que instalar nada).
# Para publicar en Vercel usa Turso: libsql://tu-base.turso.io + su token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── Demo ──────────────────────────────────────────────────────────────────
# kW de demostración que recibe cada cuenta nueva (0 para desactivar).
DEMO_STARTER_KW=5
